# Stage 1: Cài đặt thư viện PHP production bằng Composer
FROM composer:2 AS vendor
WORKDIR /app
COPY composer.json composer.lock ./
RUN composer install --no-dev --no-interaction --no-scripts --prefer-dist --ignore-platform-reqs --optimize-autoloader

# Stage 2: Biên dịch giao diện React/Inertia và Tailwind bằng Vite
FROM node:22-alpine AS assets
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY vite.config.js tsconfig.json ./
COPY resources ./resources
COPY public ./public
COPY --from=vendor /app/vendor/tightenco/ziggy ./vendor/tightenco/ziggy
RUN npm run build

# Stage 3: Runtime chính thức FrankenPHP (PHP 8.3 + Caddy) cho Vercel Container
FROM dunglas/frankenphp:1-php8.3 AS runner
WORKDIR /app

# Cài các PHP extension cho Laravel 12, Neon PostgreSQL và xử lý ảnh WebP
RUN install-php-extensions pdo_pgsql pgsql gd bcmath intl zip opcache \
    && cp "$PHP_INI_DIR/php.ini-production" "$PHP_INI_DIR/php.ini"

# Copy mã nguồn Laravel cần thiết (bỏ qua nextjs_backup để image gọn nhẹ)
COPY artisan composer.json composer.lock Caddyfile ./
COPY app ./app
COPY bootstrap ./bootstrap
COPY config ./config
COPY database ./database
COPY public ./public
COPY resources ./resources
COPY routes ./routes
COPY storage ./storage
COPY --from=vendor /app/vendor ./vendor
COPY --from=assets /app/public/build ./public/build

# Khởi tạo thư mục runtime và làm mới package discovery (loại bỏ dev packages)
RUN rm -f bootstrap/cache/*.php \
    && mkdir -p storage/framework/sessions storage/framework/views storage/framework/cache/data storage/logs \
    && chmod -R 775 storage bootstrap/cache \
    && php artisan package:discover --ansi

EXPOSE 80
CMD ["frankenphp", "run", "--config", "/app/Caddyfile"]
